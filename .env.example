SLACK_WEBHOOK_SYSTEM=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_WEB=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional HTTP proxy for Lancers search pages. Leave unset to fetch Lancers directly from this server.
# If the proxy is unreachable the scraper falls back to a direct connection by itself.
# LANCERS_PROXY=http://user:pass@host:port
# Extension server (nginx proxies wss:// to it)
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
# Database shared by main.py and run_server.py (default: data/lancers.db)
# LANCERS_DB=

# Encrypts your OpenRouter / OpenAI key (python manage.py gen-secret); keep it: changing it makes saved keys unreadable
PROFILE_SECRET=
# Optional: one line per bid result / operator alerts (logged-out relay browser, page layout changed)
SLACK_WEBHOOK_BIDS=
SLACK_WEBHOOK_ALERTS=
# Proposals generated per user per day unless their profile says otherwise
DEFAULT_DAILY_LIMIT=50
